{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bilgi-ship-it/kepenk/main/schemas/kepenk-approval-receipt-v1.schema.json",
  "title": "Kepenk signed approval receipt version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "algorithm", "key_id", "payload", "signature"],
  "properties": {
    "version": {
      "const": 1
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "key_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    },
    "signature": {
      "type": "string",
      "minLength": 86,
      "maxLength": 86,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Unpadded base64url encoding of the 64-byte Ed25519 signature."
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "command", "path", "host", "repository", "metadata"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "command": {
          "$ref": "#/$defs/nullableString"
        },
        "path": {
          "$ref": "#/$defs/nullableString"
        },
        "host": {
          "$ref": "#/$defs/nullableString"
        },
        "repository": {
          "$ref": "#/$defs/nullableString"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "reason", "rule_id"],
      "properties": {
        "effect": {
          "const": "approval"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rule_id": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issued_at",
        "expires_at",
        "nonce",
        "policy_sha256",
        "decision",
        "action"
      ],
      "properties": {
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision": {
          "$ref": "#/$defs/decision"
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      }
    }
  }
}
